SECRET_KEY=replace-with-a-long-random-value
APP_ENV=development
DATABASE_PATH=/app/instance/foodlab.sqlite3
UPLOAD_FOLDER=/app/frontend/images/uploads
CONTENT_FILTER_WORDS_FILE=/app/backend/data/blocked_words.txt
# 评论区额外短语用英文逗号分隔；生产环境建议改用独立词库文件维护
CONTENT_FILTER_EXTRA_WORDS=
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
SEED_DEMO_DATA=1
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
